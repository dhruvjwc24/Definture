# Copy to .env — never commit real secrets
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://localhost:5432/smarttakt
# Set PGSSL=true for managed Postgres (AWS RDS / Azure / Cloud SQL)
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=8h
# Protects POST /api/platform/tenants (customer onboarding). Leave empty to disable.
PLATFORM_ADMIN_KEY=
# Comma-separated origins allowed when the client is hosted separately (CDN). Not needed when the API serves the client.
CORS_ORIGIN=
